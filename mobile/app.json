{
  "expo": {
    "name": "Torneos",
    "slug": "torneos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#07140d",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.torneos.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07140d"
      }
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "//": "La URL de la API viene de EXPO_PUBLIC_API_URL (ver .env.example). Aqui solo queda la config de EAS.",
      "eas": {
        "//": "RELLENAR con el projectId de tu proyecto EAS antes del build. Sin esto, el push no obtiene token.",
        "projectId": ""
      }
    }
  }
}
